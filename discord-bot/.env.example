# ===== Discord =====
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Channel where patrol / field alerts are posted
PATROL_CHANNEL_ID=

# Dedicated channel where the bot posts every audit-log entry (لوق العمليات).
# The bot needs View Channel + Send Messages on it.
AUDIT_CHANNEL_ID=

# Dedicated channel for citizen recruitment announcements (توظيف مواطن).
# Falls back to the patrol channel when empty.
RECRUIT_CHANNEL_ID=

# Channel where news images/videos are uploaded as Discord attachments.
# Falls back to the patrol channel when empty.
NEWS_CHANNEL_ID=

# ===== Role IDs (feature 3,4,5,7,8) =====
RECRUITMENT_ROLE_ID=      # مسؤولو التوظيف (feature 4)
NEW_RECRUIT_ROLE_ID=      # رتبة المستجد الجديد (feature 4)
ON_LEAVE_ROLE_ID=         # رتبة "إجازة" (feature 7)
STRIKE_WARNING_ROLE_ID=   # رتبة الإنذار (feature 8)
SUSPENSION_ROLE_ID=       # رتبة الإيقاف/الفصل التأديبي (feature 8)
ADMIN_ROLE_ID=            # رتبة مدير عام (feature 5)
COMMAND_ROLE_ID=          # رتبة قيادة (feature 5)
OFFICIAL_MEMBER_ROLE_ID=  # رتبة العضو الرسمي — granted on application approval + stripped on discharge

# ===== RBAC masters =====
# Only the hardcoded Master Super Admin may hold the 'master' grant.
MASTER_ADMIN_ID=897450827353063505
MASTER_ADMIN_IDS=897450827353063505

# Comma-separated voice channel IDs to track live (feature 6)
VOICE_ROOM_IDS=

# ===== Supabase (Service Role — bypasses RLS, server-side only) =====
# SUPABASE_SERVICE_ROLE_KEY is REQUIRED for the bot to read/write the RBAC
# tables (admins, blacklist, applications, ...). Without it the bot falls back
# to the anon key, which RLS blocks on every protected table.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for the bot's HTTP control API (the portal sends it as
# x-bot-secret). Compared in constant time.
PATROL_BOT_SECRET=
PATROL_BOT_PORT=4000

# Portal URL used in recruitment welcome DMs
PORTAL_URL=http://localhost:3001
